{
  "name": "creditcardmatch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:smoke": "bash scripts/smoke-infrastructure.sh",
    "security:audit": "npm audit --audit-level=high",
    "db:migrate:production": "supabase db push",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down --volumes --remove-orphans",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run coverage && npm run test:smoke"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.7",
    "supabase": "^2.117.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
