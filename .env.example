# Copy local values from `npx supabase status` into ignored `.env.local` only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reserved for server-only administrative work. Never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Playwright target. Local tests start Next.js on http://localhost:3001.
PLAYWRIGHT_BASE_URL=

# Reserved for the Step 2b authenticated save flow.
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=
