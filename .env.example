# Public Supabase project URL. Safe for browser use only when paired with the anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-development-project.supabase.co
# Public Supabase anonymous key; use the development project's key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-development-anon-key
# Server-only administrative key. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-development-service-role-key
# Used only by the future Playwright suite against a dedicated non-production user.
E2E_TEST_USER_EMAIL=your-test-user@example.com
E2E_TEST_USER_PASSWORD=replace-with-a-non-production-password
